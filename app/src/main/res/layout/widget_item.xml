<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/item_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="username"
        android:textColor="#CDD6F4"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <!-- 左列: Gemini (周 + 5h) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_gemini_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G周: 100%"
                android:textColor="#A6E3A1"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/item_gemini_5h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G 5h: 100%"
                android:textColor="#A6E3A1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 右列: Claude (周 + 5h) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_claude_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C周: 100%"
                android:textColor="#A6E3A1"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/item_claude_5h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C 5h: 100%"
                android:textColor="#A6E3A1"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
